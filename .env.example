# =========================================================================
# DATABASE CONFIGURATION
# =========================================================================
# The connection URI for the production PostgreSQL database instance.
# - Format: postgresql://[user]:[password]@[host]:[port]/[database_name]?schema=[schema_name]
# - For Supabase/Neon, copy the pooled or direct connection string from your dashboard.
DATABASE_URL="postgresql://username:password@host:5432/database?schema=public"

# =========================================================================
# ADMIN AUTHENTICATION
# =========================================================================
# Credentials used to access the back-office /admin dashboard.
ADMIN_EMAIL="admin@oracle-kau.sa"
ADMIN_PASSWORD="ChooseAStrongPassword123!"

# Secret key used to sign and verify JWT tokens for authenticated admin sessions.
# - IMPORTANT: Change this to a secure, randomly generated string in production.
JWT_SECRET="generate-a-long-random-string-for-production"

# =========================================================================
# EMAIL NOTIFICATIONS (via Resend)
# =========================================================================
# API key obtained from Resend (https://resend.com) to dispatch partner/sponsor request emails.
RESEND_API_KEY="re_your_api_key_here"

# The email address that will receive the sponsor/partner application submissions.
NOTIFICATION_RECEIVER_EMAIL="sponsors@oracle-kau.sa"

# =========================================================================
# CLOUDFLARE TURNSTILE (Spam Protection)
# =========================================================================
# Anti-spam protection widget key pair for Turnstile (https://dash.cloudflare.com).
# Register your production domain at https://dash.cloudflare.com to get these keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your_cloudflare_turnstile_site_key"
TURNSTILE_SECRET_KEY="your_cloudflare_turnstile_secret_key"

# =========================================================================
# REGISTRATION STATUS WINDOW
# =========================================================================
# Controls whether new candidate registrations are open or closed.
# - "true"  -> Renders the registration form & CTA links across the navigation.
# - "false" -> Disables signup page routing and redirects users back to home.
NEXT_PUBLIC_REGISTRATION_OPEN="false"
