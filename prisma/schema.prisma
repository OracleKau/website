datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Member {
  id           String   @id @default(uuid())
  name         String
  role         String
  department   String   // "presidency", "tech", "media", "hr", "pr"
  initials     String
  quote        String?
  linkedin     String?
  github       String?
  twitter      String?  // Map to X
  email        String?
  imageUrl     String?
  order        Int      @default(0)
  isLeadership Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Project {
  id           String   @id @default(uuid())
  num          String
  category     String
  status       String
  name         String
  desc         String
  capabilities String   // JSON string of: { title: string, desc: string }[]
  technologies String   // JSON string of: string[]
  team         String   // JSON string of: { initials: string, name: string, role: string }[]
  github       String?
  year         String
  order        Int      @default(0)
  createdAt    DateTime @default(now())
}

model Achievement {
  id        String   @id @default(uuid())
  year      String
  title     String
  text      String
  imageUrl  String
  createdAt DateTime @default(now())
}

model Sponsor {
  id        String   @id @default(uuid())
  name      String
  tier      String
  logoUrl   String
  createdAt DateTime @default(now())
}

model ContactSubmission {
  id          String   @id @default(uuid())
  name        String
  org         String?
  email       String
  kind        String
  message     String?
  submittedAt DateTime @default(now())
  status      String   @default("New") // "New", "Contacted", "Completed"
}

model Event {
  id           String   @id @default(uuid())
  title        String
  description  String?  // Full event details description
  date         DateTime
  location     String
  locationLink String?  // Clickable link (e.g. Google Maps)
  type         String   // E.g. "Workshop", "Hackathon", "Talk"
  rsvpLink     String?  // Optional external RSVP link
  createdAt    DateTime @default(now())
}
